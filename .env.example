# Arch Linux: copy to .env; replace the credential path with your own home directory.
TZ=Europe/Amsterdam
CHECK_INTERVAL_SECONDS=3
CHROME_BINARY=/usr/bin/chromium
CHROMEDRIVER_PATH=/usr/bin/chromedriver
CHROME_NO_SANDBOX=1
FIREBASE_ENABLED=1
GOOGLE_APPLICATION_CREDENTIALS=/home/marijn/.config/brugmonitor/firebase-service-account.json
FIRESTORE_HEARTBEAT_SECONDS=30
# Local diagnostics only. No domain, tunnel or open firewall port needed.
BRUGMONITOR_HOST=127.0.0.1
BRUGMONITOR_PORT=8081
BRUGMONITOR_DATA_DIR=.data
